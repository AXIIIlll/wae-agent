{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifyResult",
  "type": "object",
  "required": [
    "result"
  ],
  "properties": {
    "result": {
      "enum": [
        "ok",
        "fail",
        "uncertain"
      ]
    },
    "reason": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "screenChanged": {
      "type": "boolean"
    }
  }
}
