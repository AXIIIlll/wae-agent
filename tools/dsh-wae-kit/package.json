{
  "name": "dsh-wae-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WAE project kit for DeepSeek Harness: a sidebar code map panel, build/device status, tunable and dataset browsers, and a WAE agent preset.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./tools": "./tools.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "tools.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
